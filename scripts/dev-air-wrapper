#!/usr/bin/env python3
"""Air development wrapper that owns daemon process-group cleanup.

Air v1.65.x starts configured commands through `/bin/sh -c`, so this wrapper
keeps Air's shell-root behavior away from the real daemon. It starts the daemon
in a new session, forwards shutdown to the whole daemon process group, and
finishes bounded escalation before Air's own kill_delay should fire.
"""

from __future__ import annotations

import os
import signal
import subprocess
import sys
import time

INT_BUDGET = 2.0
TERM_BUDGET = 1.0
POLL = 0.05

child: subprocess.Popen[bytes] | None = None
cleaning = False


def die(message: str, code: int = 2) -> None:
    print(f"dev-air-wrapper: {message}", file=sys.stderr)
    raise SystemExit(code)


def wait_for_exit(proc: subprocess.Popen[bytes], seconds: float) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            return True
        time.sleep(POLL)
    return proc.poll() is not None


def signal_group(proc: subprocess.Popen[bytes], sig: signal.Signals) -> None:
    if proc.pid <= 1:
        return
    try:
        os.killpg(proc.pid, sig)
    except ProcessLookupError:
        pass


def cleanup(signum: int | None = None, _frame: object | None = None) -> None:
    global cleaning
    proc = child
    if cleaning:
        return
    cleaning = True
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)

    if proc is None or proc.poll() is not None:
        return

    signal_group(proc, signal.SIGINT)
    if wait_for_exit(proc, INT_BUDGET):
        return

    signal_group(proc, signal.SIGTERM)
    if wait_for_exit(proc, TERM_BUDGET):
        return

    signal_group(proc, signal.SIGKILL)
    wait_for_exit(proc, 0.5)


def main(argv: list[str]) -> int:
    global child
    if not argv:
        die("usage: dev-air-wrapper <daemon> [args...]")

    signal.signal(signal.SIGINT, cleanup)
    signal.signal(signal.SIGTERM, cleanup)

    child = subprocess.Popen(argv, start_new_session=True)
    try:
        while True:
            rc = child.poll()
            if rc is not None:
                return 0 if cleaning and rc < 0 else rc
            time.sleep(POLL)
    finally:
        cleanup()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
